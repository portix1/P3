# P3 — données et configuration de site (ne jamais commiter)
/database/*
!/database/.htaccess
!/database/.gitkeep
/sessions/*
!/sessions/.htaccess
!/sessions/.gitkeep
/tmp/*
!/tmp/.htaccess
!/tmp/.gitkeep
/var/private/*
!/var/private/.gitkeep
!/var/private/.htaccess
/var/uploads/*
!/var/uploads/.gitkeep
/var/sys/*
!/var/sys/.htaccess
!/var/sys/.gitkeep
/var/modules/search/data/*
!/var/modules/search/data/.gitkeep
/var/modules/UserZone/AUTH

# SQLite, journaux, sauvegardes, secrets et fichiers locaux
*.sqlite
*.sqlite-*
*.sqlite[0-9]*
*.sqlite3
*.db
*.db-*
*.log
*.lock
*.bak
*.bak[0-9]*
*.old
*.tmp
*.swp
.env
.env.*
!.env.example
*.pem
*.p12
*.pfx
id_rsa*
id_ed25519*
/.quarantaine/
/.phpunit.result.cache
.DS_Store
Thumbs.db
