<header class="content-heading"><p class="eyebrow">{{ download }}</p><h1>{{ download }}</h1><p>{{ downloads_public_intro }}</p></header>
{% if downloads_listing == "1" %}<div class="download-category-grid">{% for downloadcategory in downloadcategory %}<article class="download-category-card"><h2><a href="dwl-cat-{{ downloadcategory.slug }}.html">{{ downloadcategory.name }}</a></h2><p>{{ downloadcategory.description }}</p><span>{{ downloadcategory.count }} {{ downloads_files_count }}</span></article>{% endfor %}</div>{% endif %}
{% if downloads_listing == "0" %}<section class="download-category-heading"><a href="dwl.html">← {{ downloads_all_categories }}</a><h2>{{ downloads_category_title }}</h2><p>{{ downloads_category_description }}</p></section>{% if downloads_has_files == "0" %}<p role="status">{{ downloads_no_files }}</p>{% endif %}<div class="download-file-list">{% for downloadfile in downloadfile %}<article class="download-file-card"><div><h3>{{ downloadfile.title }}</h3><p>{{ downloadfile.description }}</p><dl><div><dt>{{ size }}</dt><dd>{{ downloadfile.size }}</dd></div><div><dt>{{ downloads_format }}</dt><dd>{{ downloadfile.mime_type }}</dd></div><div><dt>{{ downloaded }}</dt><dd>{{ downloadfile.counter }} {{ times }}</dd></div></dl><details><summary>SHA-256</summary><code>{{ downloadfile.checksum }}</code></details></div><a class="button download-button" href="var/modules/download/download.php?id={{ downloadfile.id }}">{{ downloads_download }}</a></article>{% endfor %}</div>{% endif %}
