<header class="page-heading"><p class="eyebrow">{{ download }}</p><h1>{{ downloads_form_title }}</h1><p>{{ downloads_form_help }}</p></header>
{% include "var/modules/download/templates/nav.tpl" %}
{% if downloads_message %}<p class="status-message" role="status">{{ downloads_message }}</p>{% endif %}
<form method="post" enctype="multipart/form-data" class="settings-form download-form"><input type="hidden" name="csrf_token" value="{{ csrf_token }}" /><input type="hidden" name="download_action" value="{{ downloads_form_action }}" /><input type="hidden" name="id" value="{{ downloads_file_id }}" /><input type="hidden" name="MAX_FILE_SIZE" value="20971520" /><div class="form-grid">
<label><span>{{ news_admin_title }}</span><input type="text" name="title" value="{{ downloads_title_value }}" maxlength="200" /><small>{{ downloads_title_help }}</small></label>
<label><span>{{ downloads_category }}</span><select name="category_id" required>{% for downloadformcategory in downloadformcategory %}<option value="{{ downloadformcategory.id }}" {{ downloadformcategory.selected }}>{{ downloadformcategory.name }}</option>{% endfor %}</select></label>
<label><span>{{ news_admin_status }}</span><select name="status"><option value="draft" {{ downloads_status_draft_selected }}>{{ downloads_status_draft }}</option><option value="published" {{ downloads_status_published_selected }}>{{ downloads_status_published }}</option></select></label>
<label><span>{% if downloads_is_edit == "1" %}{{ downloads_replace_file }}{% endif %}{% if downloads_is_edit == "0" %}{{ downloads_file }}{% endif %}</span><input type="file" name="file" accept=".zip,.pdf,.png,.jpg,.jpeg,.gif,.txt,.csv,.tar,.gz" {{ downloads_file_required }} /><small>{% if downloads_is_edit == "1" %}{{ downloads_current_file }}. {{ downloads_replace_help }}{% endif %}{% if downloads_is_edit == "0" %}{{ downloads_file_help }}{% endif %}</small></label>
<label class="form-grid-wide"><span>{{ menu_description }}</span><textarea name="description" maxlength="5000">{{ downloads_description_value }}</textarea></label>
</div><div class="form-actions"><button type="submit">{{ ui_save }}</button><a class="button button-quiet" href="Admin-dwl.html">{{ ui_cancel }}</a></div></form>
