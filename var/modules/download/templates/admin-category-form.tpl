<header class="page-heading"><p class="eyebrow">{{ download }}</p><h1>{{ downloads_category_form_title }}</h1><p>{{ downloads_category_form_help }}</p></header>
{% include "var/modules/download/templates/nav.tpl" %}
{% if downloads_message %}<p class="status-message" role="status">{{ downloads_message }}</p>{% endif %}
<form method="post" class="settings-form"><input type="hidden" name="csrf_token" value="{{ csrf_token }}" /><input type="hidden" name="download_action" value="{{ downloads_category_form_action }}" /><input type="hidden" name="id" value="{{ downloads_category_id }}" /><div class="form-grid"><label><span>{{ menu_name }}</span><input type="text" name="name" value="{{ downloads_category_name_value }}" required maxlength="120" /></label><label><span>{{ downloads_slug }}</span><input type="text" name="slug" value="{{ downloads_category_slug_value }}" pattern="[a-z0-9]+(?:-[a-z0-9]+)*" /><small>{{ downloads_slug_help }}</small></label><label class="form-grid-wide"><span>{{ menu_description }}</span><textarea name="description" maxlength="5000">{{ downloads_category_description_value }}</textarea></label></div><div class="form-actions"><button type="submit">{{ ui_save }}</button><a class="button button-quiet" href="Admin-dwl-categories.html">{{ ui_cancel }}</a></div></form>
