<header class="page-heading"><p class="eyebrow">{{ download }}</p><h1>{{ downloads_management }}</h1><p>{{ downloads_management_help }}</p></header>
{% include "var/modules/download/templates/nav.tpl" %}
{% if downloads_message %}<p class="status-message" role="status">{{ downloads_message }}</p>{% endif %}
<section class="admin-section insights-wide download-admin-list"><div class="download-admin-header"><span>{{ ui_content }}</span><span>{{ downloads_category }}</span><span>{{ ui_state }}</span><span>{{ downloads_counter }}</span><span>{{ ui_actions }}</span></div>{% for downloadrow in downloadrow %}<article class="download-admin-row"><div><h2>{{ downloadrow.title }}</h2><small>{{ downloadrow.size }}</small></div><span>{{ downloadrow.category }}</span><span class="state-{{ downloadrow.status }}">{{ downloadrow.status_label }}</span><span>{{ downloadrow.counter }}</span><div class="news-row-actions"><a class="button button-quiet" href="Admin-dwl-edit-{{ downloadrow.id }}.html">{{ ui_edit }}</a><form method="post" action="Admin-dwl.html" class="inline-action" data-confirm-delete data-confirm-title="{{ downloadrow.title }}"><input type="hidden" name="csrf_token" value="{{ csrf_token }}" /><input type="hidden" name="download_action" value="delete_file" /><input type="hidden" name="id" value="{{ downloadrow.id }}" /><button type="submit" class="button-danger">{{ ui_delete }}</button></form></div></article>{% endfor %}</section>
<dialog id="confirm-delete-dialog" class="confirm-dialog" aria-labelledby="downloads-delete-dialog-title"><form method="dialog"><h2 id="downloads-delete-dialog-title">{{ downloads_delete_title }}</h2><p>{{ downloads_delete_help }} « <strong data-confirm-title></strong> ».</p><div class="dialog-actions"><button class="button button-quiet" value="cancel">{{ ui_cancel }}</button><button class="button-danger" value="confirm">{{ ui_delete }}</button></div></form></dialog>
