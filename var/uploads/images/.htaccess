Options -Indexes

# Only raster files generated by Portix are public (legacy random names or SEO names).
<FilesMatch "^(?!(?:[a-f0-9]{32}\.(?:jpg|png|webp)|[a-z0-9](?:[a-z0-9-]{0,71}[a-z0-9])?-[a-f0-9]{8}\.webp)$).*$">
    Require all denied
</FilesMatch>

<IfModule mod_mime.c>
    RemoveHandler .php .php3 .php4 .php5 .php7 .php8 .phtml .phar
    RemoveType .php .php3 .php4 .php5 .php7 .php8 .phtml .phar
</IfModule>
